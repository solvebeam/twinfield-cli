---
// The default Starlight page title; on a page of the manual it is a command, so it is set in monospace.
const { entry, id } = Astro.locals.starlightRoute;
const isCommand = id.startsWith('manual/');
---

<h1 id="_top" class:list={{ command: isCommand }}>{entry.data.title}</h1>

<style>
	h1 {
		margin-top: 1rem;
		font-size: var(--sl-text-h1);
		line-height: var(--sl-line-height-headings);
		font-weight: 600;
		color: var(--sl-color-white);
	}

	.command {
		font-family: var(--sl-font-mono);
		font-size: var(--sl-text-h2);
		letter-spacing: -0.02em;
	}

	.command::before {
		content: '$ ';
		color: var(--sl-color-accent);
		user-select: none;
	}
</style>
