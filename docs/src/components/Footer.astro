---
// The default Starlight footer, with a credit line for SolveBeam and the trademark notice.
import Default from '@astrojs/starlight/components/Footer.astro';
import solveBeamIcon from '../assets/brand/solvebeam/solvebeam-icon.svg';
---

<Default><slot /></Default>

<div class="credits">
	<a href="https://www.solvebeam.com/">
		<img src={solveBeamIcon.src} alt="" width="20" height="20" />
		Made by SolveBeam
	</a>
	<p>
		Twinfield and Wolters Kluwer are trademarks of Wolters Kluwer. Their names and logos are used only to refer to
		their products.
	</p>
</div>

<style>
	.credits {
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 0.5rem;
		margin-top: 2rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--sl-color-hairline);
		font-size: var(--sl-text-xs);
		color: var(--sl-color-gray-3);
		text-align: center;
	}

	.credits a {
		display: inline-flex;
		align-items: center;
		gap: 0.5em;
		color: var(--sl-color-gray-2);
		text-decoration: none;
		font-weight: 600;
	}

	.credits a:hover {
		color: var(--sl-color-white);
	}

	.credits p {
		margin: 0;
		max-width: 36rem;
	}
</style>
