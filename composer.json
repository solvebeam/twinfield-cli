{
  "name": "solvebeam/twinfield-cli",
  "description": "Twinfield CLI brings Twinfield to your terminal. Free and open source.",
  "homepage": "https://github.com/solvebeam/twinfield-cli",
  "license": "MIT",
  "authors": [
    {
      "name": "SolveBeam",
      "email": "info@solvebeam.com",
      "homepage": "https://www.solvebeam.com/",
      "role": "Company"
    },
    {
      "name": "Remco Tolsma",
      "email": "remco@solvebeam.com",
      "homepage": "https://www.remcotolsma.nl/",
      "role": "Developer"
    }
  ],
  "keywords": [
    "twinfield",
    "cli",
    "oauth2",
    "login",
    "credentials"
  ],
  "bin": [
    "bin/twf",
    "bin/twinfield"
  ],
  "autoload": {
    "psr-4": {
      "SolveBeam\\Twinfield\\Cli\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "SolveBeam\\Twinfield\\Cli\\Tests\\": "tests/"
    }
  },
  "require": {
    "php": "^8.3",
    "ext-json": "*",
    "league/oauth2-client": "^2.9",
    "psr/http-client": "^1.0",
    "solvebeam/oauth2-twinfield": "^0.1.1",
    "solvebeam/twinfield": "^0.2",
    "solvebeam/twinfield-connect": "^0.1.1",
    "symfony/console": "^6.4 || ^7.0 || ^8.0"
  },
  "require-dev": {
    "guzzlehttp/guzzle": "^7.9",
    "phpstan/phpstan": "^2.3",
    "phpunit/phpunit": "^12",
    "squizlabs/php_codesniffer": "^4.0"
  },
  "scripts": {
    "phpcs": "phpcs",
    "phpstan": "phpstan analyse --no-progress",
    "phpunit": "phpunit",
    "test": [
      "@phpcs",
      "@phpstan",
      "@phpunit"
    ]
  },
  "config": {
    "allow-plugins": {
      "php-http/discovery": true
    },
    "sort-packages": true,
    "platform": {
      "php": "8.3.0"
    }
  }
}
